# Meta mode requires both APP_MODE=meta and ALLOW_PAID_API_CALLS=true.
APP_MODE=mock
ALLOW_PAID_API_CALLS=false
META_TIMEOUT_SECONDS=60
META_MAX_COMPLETION_TOKENS=4096
META_MAX_CLAIMS=8
GRAPH_RECURSION_LIMIT=12
# Used by python -m clear_context. Keep one worker for local SQLite jobs.
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=info
API_DOCS_ENABLED=true
# JSON array; list browser origins explicitly. CORS is not authentication.
CORS_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
DATABASE_PATH=.local/clear-context.db
# Uploaded images and videos, stored by content hash.
MEDIA_DIR=.local/media
# Model-selection settings are validated at startup.
# Values are local aliases from config/models.yaml, not raw API IDs.
MODEL_CATALOG_PATH=config/models.yaml
PROMPT_CATALOG_PATH=config/prompts.yaml
# Select a profile from config/extractors.yaml; d_v1 is the provisional direct path.
EXTRACTOR_CATALOG_PATH=config/extractors.yaml
PROMPT_CLAIM_EXTRACTION=v2
# Character budgets are deterministic bounds, not tokenizer-based estimates.
EXTRACTION_RESPONSE_CAPACITY=24
EXTRACTION_CHUNK_CHARACTERS=600
EXTRACTION_MIN_CHUNK_CHARACTERS=200
EXTRACTION_CONTEXT_CHARACTERS=600
EXTRACTION_MAX_CALLS=24
EXTRACTION_MAX_OUTPUT_TOKENS=32768
EXTRACTION_MAX_SECONDS=120
MODEL_DEFAULT=spark_1_3
# Empty task overrides inherit MODEL_DEFAULT.
MODEL_CLAIM_EXTRACTION=
MODEL_SCREENSHOT=
MODEL_RESEARCH=
MODEL_JUDGE=
MODEL_REPORT=
MODEL_ALLOW_TRAINING_USE=false
# Set locally; never commit a real key.
META_API_KEY=

BASETEN_API_KEY=
# Optional Tavily key for source research; empty uses rate-limited keyless access.
TAVILY_API_KEY=
# Reverse image search adapter: none or serpapi_lens. Only used in Meta mode
# with paid calls allowed; each image is uploaded to the selected provider.
REVERSE_IMAGE_PROVIDER=none
# SerpApi Google Lens: one upload plus one or two searches per image.
SERP_API_KEY=

# Local web server and optional API proxy override.
WEB_HOST=127.0.0.1
WEB_PORT=5173
API_PROXY_TARGET=
RESEARCH_ENABLED=false
# Component judge profile from config/judges.yaml for application research.
RESEARCH_JUDGE_PROFILE=need_components_v4
